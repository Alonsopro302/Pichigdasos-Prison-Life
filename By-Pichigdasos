local Camera = workspace.CurrentCamera
local aimbotEnabled = false
local fov = 80
local teamCheck = false
local killCheck = false
local wallCheck = false
local targetPartName = "Head"

local circle = Drawing.new("Circle")
circle.Thickness = 1.5
circle.Color = Color3.fromRGB(255, 255, 255)
circle.Filled = false
circle.Visible = false

local function findBestTarget()
    local bestDist = 1e999
    local bestPlayer = nil
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local character = player.Character
        if not character then continue end
        local targetPart = character:FindFirstChild(targetPartName)
        if not targetPart then continue end
        if teamCheck and player.Team == LocalPlayer.Team then continue end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if killCheck and (not humanoid or humanoid.Health <= 0) then continue end
        if wallCheck then
            local origin = Camera.CFrame.Position
            local direction = (targetPart.Position - origin).Unit * 500
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances = { LocalPlayer.Character }
            local result = workspace:Raycast(origin, direction, params)
            if result and not character:IsAncestorOf(result.Instance) then continue end
        end
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if onScreen then
            local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
            if dist < fov and dist < bestDist then
                bestDist = dist; bestPlayer = player
            end
        end
    end
    return bestPlayer
end

RunService:BindToRenderStep("AimbotRender", Enum.RenderPriority.Camera.Value + 1, function()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    circle.Position = center
    circle.Radius = fov
    circle.Visible = aimbotEnabled
    if aimbotEnabled then
        local target = findBestTarget()
        if target and target.Character and target.Character:FindFirstChild(targetPartName) then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Character[targetPartName].Position)
        end
    end
end)

