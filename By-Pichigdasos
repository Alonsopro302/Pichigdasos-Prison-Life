local function setupESP()
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        p.CharacterAdded:Connect(function(c)
            local h=Instance.new("Highlight")
            h.FillColor=getColor(p)
            h.OutlineColor=Color3.new(1,1,1)
            h.FillTransparency=0.3
            h.OutlineTransparency=0
            h.Parent=c
            highlights[p]=h
        end)
    end
    RunService:BindToRenderStep("ESPRender",Enum.RenderPriority.Camera.Value,function()
        if not espEnabled then return end
        local vp=Camera.ViewportSize
        local bot=Vector2.new(vp.X/2,vp.Y)
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LocalPlayer then continue end
            local c=p.Character
            if not c then continue end
            local head=c:FindFirstChild("Head")
            if not head then continue end
            local pos,onscr=Camera:WorldToViewportPoint(head.Position)
            if not onscr then continue end
            local col=getColor(p)
            if highlights[p] then highlights[p].FillColor=col end
            if showNames then
                if not names[p] then
                    local t=Drawing.new("Text")
                    t.Center=true
                    t.Outline=true
                    t.OutlineColor=Color3.new(0,0,0)
                    t.Size=14
                    names[p]=t
                end
                local tx=names[p]
                tx.Text=p.Name
                tx.Color=col
                tx.Position=Vector2.new(pos.X,pos.Y-30)
                tx.Visible=true
            else
                if names[p] then names[p].Visible=false end
            end
            if showTracers then
                if not lines[p] then
                    local l=Drawing.new("Line")
                    l.Thickness=1.5
                    l.Transparency=0.7
                    lines[p]=l
                end
                local li=lines[p]
                li.From=bot
                li.To=Vector2.new(pos.X,pos.Y)
                li.Color=col
                li.Visible=true
            else
                if lines[p] then lines[p].Visible=false end
            end
        end
    end)
end

