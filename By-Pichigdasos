	local localValuePlayer = game:GetService("Players").LocalPlayer

	TeleportService:Teleport(game.PlaceId, localValuePlayer)
end)

local nextSection = secondaryTab:NewSection("Full")

nextSection:NewButton("Fps boots", "ButtonInfo", function(_)
	local data = {
		Textures = false,
		VisualEffects = true,
		Parts = true,
		Particles = true,
		Sky = true
	};

	({}).FullBright = false

	local vs = {}

	for _, item in next, game:GetDescendants() do
		if data.Parts and (item:IsA("Part") or item:IsA("Union") or item:IsA("BasePart")) then
			item.Material = Enum.Material.SmoothPlastic
			table.insert(vs, 1, item)
		end

		if data.Particles and (item:IsA("ParticleEmitter") or item:IsA("Smoke") or item:IsA("Explosion") or item:IsA("Sparkles") or item:IsA("Fire")) then
			item.Enabled = false
			table.insert(vs, 1, item)
		end

		if data.VisualEffects and (item:IsA("BloomEffect") or item:IsA("BlurEffect") or item:IsA("DepthOfFieldEffect") or item:IsA("SunRaysEffect")) then
			item.Enabled = false
			table.insert(vs, 1, item)
		end

		if data.Textures and (item:IsA("Decal") or item:IsA("Texture")) then
			item.Texture = ""
			table.insert(vs, 1, item)
		end

		if data.Sky and item:IsA("Sky") then
			item.Parent = nil
			table.insert(vs, 1, item)
		end
	end
end)

local lighting = game:GetService("Lighting")

function dofullbright()
	lighting.Ambient = Color3.new(1, 1, 1)
	lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
	lighting.ColorShift_Top = Color3.new(1, 1, 1)
	game.Lighting.FogEnd = 100000
	game.Lighting.FogStart = 0
	game.Lighting.ClockTime = 14
	game.Lighting.Brightness = 2
	game.Lighting.GlobalShadows = false
end

nextSection:NewButton("Full bright", "ButtonInfo", function(argument)
	dofullbright(argument)
end)
