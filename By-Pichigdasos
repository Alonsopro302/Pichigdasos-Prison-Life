local antiArrestEnabled = false
local antiTaseEnabled = false
local animConnection = nil
local ARREST_ANIMATION = "rbxassetid://287112271"
local TASE_ANIMATION = "rbxassetid://279227693"

local function setupProtectionConnection()
    if animConnection then animConnection:Disconnect() end
    local function onCharacterAdded(char)
        local humanoid = char:WaitForChild("Humanoid")
        local animator = humanoid:WaitForChild("Animator")
        animator.AnimationPlayed:Connect(function(des)
            if antiArrestEnabled and des.Animation.AnimationId == ARREST_ANIMATION then
                local Humanoid = LocalPlayer.Character:WaitForChild("Humanoid")
                Humanoid:ChangeState(Enum.HumanoidStateType.Dead)
                local cpos = char:WaitForChild("HumanoidRootPart").CFrame
                local wasCriminal = (LocalPlayer.TeamColor.Name == "Really red")
                LocalPlayer.CharacterAdded:Wait()
                repeat task.wait() until LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                task.wait(0.1)
                if wasCriminal then
                    pcall(function()
                        LocalPlayer.Character.HumanoidRootPart.CFrame = cpos
                    end)
                end
            end
            if antiTaseEnabled and des.Animation.AnimationId == TASE_ANIMATION then
                des:Stop()
                des:Destroy()
                LocalPlayer.Character.Humanoid.PlatformStand = false
                LocalPlayer.Character.Humanoid.Sit = false
                LocalPlayer.Character.Humanoid.WalkSpeed = 16
                LocalPlayer.Character.Humanoid.JumpPower = 50
            end
        end)
    end
    if LocalPlayer.Character then
        onCharacterAdded(LocalPlayer.Character)
    end
    animConnection = LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
end

