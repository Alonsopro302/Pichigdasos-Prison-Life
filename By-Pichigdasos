-- Funcion principal de traduccion
local function tr(key)
    return translations[currentLang][key] or translations["es"][key] or key
end

-- ============================================================
-- SISTEMA DE ACTUALIZACION DE TEXTO EN INSTANCIAS ROBLOX
-- ============================================================

--[[
    Este es el nucleo del sistema mejorado.
    Cada elemento WindUI creado se guarda con:
    - La instancia GUI de Roblox (frame principal)
    - La clave de traduccion
    - Informacion sobre que texto actualizar
    
    La funcion explora la jerarquia de la instancia buscando
    TextLabels y TextButtons que coincidan con el texto original,
    o actualiza el primer TextLabel/TextButton relevante encontrado.
]]

local trackedElements = {}
local trackedSections = {}  -- Secciones principales (barra lateral)
local trackedTabs = {}      -- Pestañas dentro de cada seccion
local flyGuiElements = {}   -- Elementos del FlyGui

-- Busca recursivamente todos los TextLabel/TextButton en una instancia
local function findAllTextObjects(instance)
    local texts = {}
    if not instance then return texts end
    
    local function scan(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            table.insert(texts, obj)
        end
        for _, child in ipairs(obj:GetChildren()) do
            scan(child)
        end
    end
    
    pcall(scan, instance)
    return texts
end

-- Obtiene la instancia GUI principal de un elemento WindUI
local function getWindUIRoot(element)
    if not element then return nil end
    
    -- WindUI suele exponer la instancia de estas formas
    local candidates = {
        element.Instance,
        element.GuiObject,
        element.Frame,
        element.Object,
        element,  -- A veces el propio elemento ES la instancia
    }
    
    for _, cand in ipairs(candidates) do
        if cand and typeof(cand) == "Instance" then
            return cand
        end
    end
    
    -- Ultimo recurso: buscar cualquier instancia en las propiedades
    pcall(function()
        for k, v in pairs(element) do
            if typeof(v) == "Instance" and v:IsA("GuiObject") then
                return v
            end
        end
    end)
    
    return nil
end

-- Registra un elemento para seguimiento de traduccion
local function registerElement(element, translationKey, originalTextES)
    if not element then return end
    
    local root = getWindUIRoot(element)
    local textObjects = findAllTextObjects(root)
    
    table.insert(trackedElements, {
        element = element,
        root = root,
        key = translationKey,
        originalES = originalTextES or translations["es"][translationKey],
        textObjects = textObjects
    })
    
    return #trackedElements
end

-- Registra una seccion principal (barra lateral)
local function registerSection(section, translationKey)
    if not section then return end
    
    local root = getWindUIRoot(section)
    local textObjects = findAllTextObjects(root)
    
    table.insert(trackedSections, {
        section = section,
        root = root,
        key = translationKey,
        textObjects = textObjects
    })
end

-- Registra una pestaña
local function registerTab(tab, translationKey)
    if not tab then return end
    
    local root = getWindUIRoot(tab)
    local textObjects = findAllTextObjects(root)
    
    table.insert(trackedTabs, {
        tab = tab,
        root = root,
        key = translationKey,
        textObjects = textObjects
    })
end

-- Actualiza TODOS los textos registrados
local function refreshAllTranslations()
    -- Actualizar elementos normales
    for _, entry in ipairs(trackedElements) do
        local newText = tr(entry.key)
        local targetES = entry.originalES
        
        -- Re-escanear por si la instancia cambio
        local textObjects = findAllTextObjects(entry.root)
        entry.textObjects = textObjects
        
        for _, textObj in ipairs(textObjects) do
            -- Si el texto actual coincide con el original en ES, traducir
            -- O si coincide con cualquier traduccion registrada
            local currentText = textObj.Text
            
            -- Buscar si este texto corresponde a la clave
            local matches = false
            for lang, dict in pairs(translations) do
                if dict[entry.key] and dict[entry.key] == currentText then
                    matches = true
                    break
                end
            end
            
            -- Si es el primer TextLabel grande o coincide, actualizar
            if matches or currentText == targetES then
                pcall(function() textObj.Text = newText end)
            end
        end
    end
    
    -- Actualizar secciones principales (barra lateral)
    for _, entry in ipairs(trackedSections) do
        local newText = tr(entry.key)
        local textObjects = findAllTextObjects(entry.root)
        entry.textObjects = textObjects
        
        for _, textObj in ipairs(textObjects) do
            local currentText = textObj.Text
            local matches = false
            for lang, dict in pairs(translations) do
                if dict[entry.key] and dict[entry.key] == currentText then
                    matches = true
                    break
                end
            end
            if matches then
                pcall(function() textObj.Text = newText end)
            end
        end
    end
    
    -- Actualizar pestañas
    for _, entry in ipairs(trackedTabs) do
        local newText = tr(entry.key)
        local textObjects = findAllTextObjects(entry.root)
        entry.textObjects = textObjects
        
        for _, textObj in ipairs(textObjects) do
            local currentText = textObj.Text
            local matches = false
            for lang, dict in pairs(translations) do
                if dict[entry.key] and dict[entry.key] == currentText then
                    matches = true
                    break
                end
            end
            if matches then
                pcall(function() textObj.Text = newText end)
            end
        end
    end
    
    -- Actualizar FlyGui si esta abierto
    if _G.currentFlyGui and flyGuiElements.title then
        pcall(function() flyGuiElements.title.Text = tr("FlyGui_Title") end)
    end
    if _G.flyButton4 then
        if _G.flyActive then
            pcall(function() _G.flyButton4.Text = tr("Fly_UnFly") end)
        else
            pcall(function() _G.flyButton4.Text = tr("Fly_Fly") end)
        end
    end
    
    -- Notificacion
    if currentLang == "es" then
        WindUI:Notify({Title = tr("Notif_Success"), Description = tr("Notif_LangChangedES"), Duration = 2})
    else
        WindUI:Notify({Title = tr("Notif_Success"), Description = tr("Notif_LangChangedEN"), Duration = 2})
    end
end

