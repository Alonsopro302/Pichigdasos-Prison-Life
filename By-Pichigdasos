local Camera = workspace.CurrentCamera
local aimbotEnabled = false
local fov = 80
local teamCheck = false
local killCheck = false
local wallCheck = false
local targetPartName = "Head"

local circle = Drawing.new("Circle")
circle.Thickness = 1.5
circle.Color = Color3.fromRGB(255,255,255)
circle.Filled = false
circle.Visible = false

local function findBestTarget()
    local bestDist=1e999
    local bestPlayer=nil
    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,p in pairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        local c=p.Character
        if not c then continue end
        local tp=c:FindFirstChild(targetPartName)
        if not tp then continue end
        if teamCheck and p.Team==LocalPlayer.Team then continue end
        local hum=c:FindFirstChildOfClass("Humanoid")
        if killCheck and (not hum or hum.Health<=0) then continue end
        if wallCheck then
            local origin=Camera.CFrame.Position
            local dir=(tp.Position-origin).Unit*500
            local params=RaycastParams.new()
            params.FilterType=Enum.RaycastFilterType.Blacklist
            params.FilterDescendantsInstances={LocalPlayer.Character}
            local res=workspace:Raycast(origin,dir,params)
            if res and not c:IsAncestorOf(res.Instance) then continue end
        end
        local sp,onScr=Camera:WorldToViewportPoint(tp.Position)
        if onScr then
            local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
            if d<fov and d<bestDist then bestDist=d bestPlayer=p end
        end
    end
    return bestPlayer
end

RunService:BindToRenderStep("AimbotRender",Enum.RenderPriority.Camera.Value+1,function()
    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    circle.Position=center
    circle.Radius=fov
    circle.Visible=aimbotEnabled
    if aimbotEnabled then
        local tgt=findBestTarget()
        if tgt and tgt.Character and tgt.Character:FindFirstChild(targetPartName) then
            Camera.CFrame=CFrame.new(Camera.CFrame.Position,tgt.Character[targetPartName].Position)
        end
    end
end)

