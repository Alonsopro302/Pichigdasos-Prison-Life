						updateInstancePropertiesText.Visible = false
					else
						drawing.Size = Vector2.new(50, 50)
						drawing.Position = Vector2.new(vector.X - drawing.Size.X / 2, vector.Y - drawing.Size.Y / 2)
						drawing.Visible = true
						updateInstancePropertiesText.Position = Vector2.new(vector.X, vector.Y - 30)
						updateInstancePropertiesText.Text = instance.Name
						updateInstancePropertiesText.Visible = true
					end

					return
				end

				drawing.Visible = false
				updateInstancePropertiesText.Visible = false
			end)
		end)()

		return
	end
end;

