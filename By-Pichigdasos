local UserInputService = game:GetService("UserInputService")
local FlipCooldown = false

local function FortniteFlips()
    if FlipCooldown then return end
    FlipCooldown = true
    local chr = player.Character
    local hrp = chr and chr:FindFirstChild("HumanoidRootPart")
    local hum = chr and chr:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    local animate = chr and chr:FindFirstChild("Animate")
    if not hrp or not hum then FlipCooldown = false return end
    local savedTracks = {}
    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            savedTracks[#savedTracks+1] = {track=track,time=track.TimePosition,speed=track.Speed,weight=track.WeightCurrent}
            track:Stop(0)
        end
    end
    local animateWasEnabled = animate and animate.Enabled
    if animate then animate.Enabled = false end
    local oldAutoRotate = hum.AutoRotate
    hum.AutoRotate = false
    hum:ChangeState(Enum.HumanoidStateType.Physics)
    local duration = 0.45
    local steps = 120
    local startCFrame = hrp.CFrame
    local forwardVector = startCFrame.LookVector
    local upVector = Vector3.new(0,1,0)
    task.spawn(function()
        local startTime = tick()
        for i=1,steps do
            if not chr.Parent or hum.Health <= 0 then break end
            local t = i/steps
            local height = 4*(t-t^2)*10
            local nextPos = startCFrame.Position + forwardVector*35*t + upVector*height
            local rotation = startCFrame.Rotation * CFrame.Angles(-math.rad(i*(360/steps)),0,0)
            hrp.CFrame = CFrame.new(nextPos)*rotation
            local elapsed = tick()-startTime
            local expected = (duration/steps)*i
            local waitTime = expected-elapsed
            if waitTime>0 then task.wait(waitTime) end
        end
        if chr.Parent and hum.Health>0 then
            hrp.CFrame = CFrame.new(startCFrame.Position+forwardVector*35)*startCFrame.Rotation
            hum.AutoRotate = oldAutoRotate
            if animate then animate.Enabled = animateWasEnabled~=false end
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            task.wait(0.05)
            hum:ChangeState(Enum.HumanoidStateType.Running)
            task.wait(0.1)
            if animator then
                for _,dat in ipairs(savedTracks) do
                    if dat.track and dat.track.Parent then
                        pcall(function()
                            dat.track:Play(0.1,dat.weight,dat.speed)
                            dat.track.TimePosition = dat.time
                        end)
                    end
                end
            end
        end
        task.wait(0.25)
        FlipCooldown = false
    end)
end

