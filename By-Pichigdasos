local gunPositions = {
    ["Remington 870"] = CFrame.new(820.298583984375, 87.85000610351562, 2229.396240234375),
    ["MP5"] = CFrame.new(813.6986694335938, 87.85000610351562, 2229.396240234375),
    ["AK-47"] = CFrame.new(-931.7928466796875, 81.27831268310547, 2039.2554931640625),
}

local touchGiverCache = {}

local function getTouchGiver(gunName)
    if touchGiverCache[gunName] then
        return touchGiverCache[gunName]
    end
    local targetPos = gunPositions[gunName]
    if not targetPos then return nil end
    for _, weapongiver in ipairs(workspace:QueryDescendants("#TouchGiver")) do
        if weapongiver and weapongiver:IsA("Model") then
            if weapongiver:GetPivot().Position == targetPos.Position + Vector3.new(0, 10, 0) then
                touchGiverCache[gunName] = weapongiver
                return weapongiver
            end
        end
    end
    return nil
end

local function hasGun(name)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return (backpack and backpack:FindFirstChild(name)) or (char and char:FindFirstChild(name))
end

local function GetGun(gunName)
    local targetPos = gunPositions[gunName]
    if not targetPos then
        WindUI:Notify({Title = "Error", Description = "Posición no encontrada para " .. gunName, Duration = 3})
        return false
    end
    local targetGiver = getTouchGiver(gunName)
    if not targetGiver then
        WindUI:Notify({Title = "Error", Description = "No se encontró el TouchGiver para " .. gunName, Duration = 3})
        return false
    end
    local char = LocalPlayer.Character
    if not char then
        WindUI:Notify({Title = "Error", Description = "Personaje no encontrado", Duration = 2})
        return false
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local oldPos = hrp.CFrame
    local success = false
    local startTime = tick()
    local timeout = 2
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not char or not char.Parent then
            conn:Disconnect()
            return
        end
        hrp.CFrame = targetPos
        pcall(function()
            remote:FireServer(targetGiver)
        end)
        if hasGun(gunName) then
            success = true
            conn:Disconnect()
            hrp.CFrame = oldPos
        end
    end)
    while not success and tick() - startTime < timeout do
        task.wait(0.1)
    end
    if conn and conn.Connected then
        conn:Disconnect()
        hrp.CFrame = oldPos
    end
    if success then
        WindUI:Notify({Title = "Exito", Description = "Obtuviste: " .. gunName, Duration = 2})
    else
        WindUI:Notify({Title = "Error", Description = "No se pudo obtener " .. gunName, Duration = 2})
    end
    return success
end

local function GrabAllGuns()
    local obtained = {}
    for _, gun in ipairs({"Remington 870", "MP5", "AK-47"}) do
        if not hasGun(gun) then
            if GetGun(gun) then
                table.insert(obtained, gun)
            end
            task.wait(0.2)
        end
    end
    if #obtained == 0 then
        WindUI:Notify({Title = "Info", Description = "Ya tienes todas las armas", Duration = 2})
    else
        WindUI:Notify({Title = "Listo", Description = "Obtuviste " .. #obtained .. " arma(s)", Duration = 2})
    end
end

