local espEnabled = false
local showNames = false
local showTracers = false
local teamColors = true

local highlightList = {}
local nameTexts = {}
local tracerLines = {}
local connections = {}

local function getPlayerColor(player)
    if not teamColors then
        return Color3.fromRGB(255, 0, 0)
    end
    if player.Team == LocalPlayer.Team then
        return Color3.fromRGB(0, 255, 0)
    else
        return Color3.fromRGB(255, 0, 0)
    end
end

local function applyHighlight(player)
    if player == LocalPlayer then return end
    local character = player.Character
    if not character then return end
    if highlightList[player] then return end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = getPlayerColor(player)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.3
    highlight.OutlineTransparency = 0
    highlight.Parent = character
    highlightList[player] = highlight
end

local function removeHighlight(player)
    local highlight = highlightList[player]
    if highlight then
        highlight:Destroy()
        highlightList[player] = nil
    end
end

local function clearAllHighlights()
    for player, highlight in pairs(highlightList) do
        highlight:Destroy()
    end
    highlightList = {}
end

local function createNameText(player)
    if nameTexts[player] then return end
    local text = Drawing.new("Text")
    text.Text = player.Name
    text.Size = 14
    text.Center = true
    text.Outline = true
    text.OutlineColor = Color3.fromRGB(0, 0, 0)
    text.Color = getPlayerColor(player)
    text.Visible = false
    nameTexts[player] = text
end

local function removeNameText(player)
    local text = nameTexts[player]
    if text then
        text:Destroy()
        nameTexts[player] = nil
    end
end

local function createTracer(player)
    if tracerLines[player] then return end
    local line = Drawing.new("Line")
    line.Thickness = 1.5
    line.Color = getPlayerColor(player)
    line.Transparency = 0.7
    line.Visible = false
    tracerLines[player] = line
end

local function removeTracer(player)
    local line = tracerLines[player]
    if line then
        line:Destroy()
        tracerLines[player] = nil
    end
end

local function clearAllDrawings()
    for player in pairs(nameTexts) do
        removeNameText(player)
    end
    for player in pairs(tracerLines) do
        removeTracer(player)
    end
end

local function disconnectAll()
    for _, conn in pairs(connections) do
        conn:Disconnect()
    end
    connections = {}
end

local function updateESP()
    local viewport = Camera.ViewportSize
    local centerBottom = Vector2.new(viewport.X / 2, viewport.Y)

    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local character = player.Character
        if not character then
            if highlightList[player] then removeHighlight(player) end
            if nameTexts[player] then removeNameText(player) end
            if tracerLines[player] then removeTracer(player) end
            continue
        end

        local head = character:FindFirstChild("Head")
        if not head then
            if highlightList[player] then removeHighlight(player) end
            if nameTexts[player] then removeNameText(player) end
            if tracerLines[player] then removeTracer(player) end
            continue
        end

        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            if highlightList[player] then removeHighlight(player) end
            if nameTexts[player] then removeNameText(player) end
            if tracerLines[player] then removeTracer(player) end
            continue
        end

        if espEnabled then
            local color = getPlayerColor(player)
            local highlight = highlightList[player]
            if not highlight then
                applyHighlight(player)
            else
                highlight.FillColor = color
            end

            if showNames then
                local text = nameTexts[player]
                if not text then
                    createNameText(player)
                    text = nameTexts[player]
                end
                text.Position = Vector2.new(pos.X, pos.Y - 30)
                text.Color = color
                text.Visible = true
            else
                if nameTexts[player] then
                    nameTexts[player].Visible = false
                end
            end

            if showTracers then
                local line = tracerLines[player]
                if not line then
                    createTracer(player)
                    line = tracerLines[player]
                end
                line.From = centerBottom
                line.To = Vector2.new(pos.X, pos.Y)
                line.Color = color
                line.Visible = true
            else
                if tracerLines[player] then
                    tracerLines[player].Visible = false
                end
            end
        end
    end
end

local function setupESP()
    clearAllHighlights()
    clearAllDrawings()
    disconnectAll()

    for _, player in pairs(Players:GetPlayers()) do
        applyHighlight(player)
        createNameText(player)
        createTracer(player)
    end

    local function onPlayerAdded(player)
        applyHighlight(player)
        createNameText(player)
        createTracer(player)
        local charConn
        charConn = player.CharacterAdded:Connect(function()
            applyHighlight(player)
        end)
        connections[player] = charConn
    end

    local function onPlayerRemoving(player)
        removeHighlight(player)
        removeNameText(player)
        removeTracer(player)
        if connections[player] then
            connections[player]:Disconnect()
            connections[player] = nil
        end
    end

    connections.PlayerAdded = Players.PlayerAdded:Connect(onPlayerAdded)
    connections.PlayerRemoving = Players.PlayerRemoving:Connect(onPlayerRemoving)

    for _, player in pairs(Players:GetPlayers()) do
        if not connections[player] then
            local charConn
            charConn = player.CharacterAdded:Connect(function()
                applyHighlight(player)
            end)
            connections[player] = charConn
        end
    end

    RunService:BindToRenderStep("ESPRender", Enum.RenderPriority.Camera.Value, updateESP)
end

local function disableESP()
    clearAllHighlights()
    clearAllDrawings()
    disconnectAll()
    RunService:UnbindFromRenderStep("ESPRender")
end

